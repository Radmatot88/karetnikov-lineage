        return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);

      }



      // --- MOUSE DRAG (Works anywhere on canvas, including cards) ---

      shell.addEventListener('mousedown', (e) => {

        if (e.target.closest('.hud-panel') || e.target.closest('.roadmap-zoom-dock') || e.target.closest('.mobile-hud-toggle-btn') || e.target.closest('.clan-switcher-bar')) {

          return;

        }

        isPointerDown = true;

        hasDragged = false;

        startX = e.clientX;

        startY = e.clientY;

        startPanX = panX;

        startPanY = panY;

      });



      window.addEventListener('mousemove', (e) => {

        if (!isPointerDown) return;

        const dx = e.clientX - startX;

        const dy = e.clientY - startY;

        if (!hasDragged && Math.hypot(dx, dy) >= DRAG_THRESHOLD) {

          hasDragged = true;

          shell.classList.add('dragging');

        }

        if (hasDragged) {

          panX = startPanX + dx;

          panY = startPanY + dy;

          clampPan();

          applyRoadmapTransform();

        }

      });



      window.addEventListener('mouseup', () => {

        if (isPointerDown && hasDragged) {

          suppressCardClickUntil = Date.now() + 200;

        }

        isPointerDown = false;

        hasDragged = false;

        shell.classList.remove('dragging');

      });



      // --- TOUCH GESTURES (Single finger drag anywhere + 2-finger pinch) ---

      shell.addEventListener('touchstart', (e) => {

        if (e.target.closest('.hud-panel') || e.target.closest('.roadmap-zoom-dock') || e.target.closest('.mobile-hud-toggle-btn') || e.target.closest('.clan-switcher-bar')) {

          return;

        }

        if (e.touches.length === 1) {

          isPinching = false;

          isPointerDown = true;

          hasDragged = false;

          startX = e.touches[0].clientX;

          startY = e.touches[0].clientY;

          startPanX = panX;

          startPanY = panY;

        } else if (e.touches.length === 2) {

          isPointerDown = false;

          hasDragged = true;

          isPinching = true;

          pinchStartDist = getTouchDist(e.touches[0], e.touches[1]);

          pinchStartZoom = zoom;

          const rect = shell.getBoundingClientRect();

          pinchMidX = ((e.touches[0].clientX + e.touches[1].clientX) / 2) - rect.left;

          pinchMidY = ((e.touches[0].clientY + e.touches[1].clientY) / 2) - rect.top;

        }

      }, { passive: true });



      shell.addEventListener('touchmove', (e) => {

        if (e.touches.length === 1 && isPointerDown) {

          const dx = e.touches[0].clientX - startX;

          const dy = e.touches[0].clientY - startY;

          if (!hasDragged && Math.hypot(dx, dy) >= DRAG_THRESHOLD) {

            hasDragged = true;

          }

          if (hasDragged) {

            e.preventDefault();

            panX = startPanX + dx;

            panY = startPanY + dy;

            clampPan();

            applyRoadmapTransform();

          }

        } else if (e.touches.length === 2 && isPinching && pinchStartDist > 0) {

          e.preventDefault();

          const newDist = getTouchDist(e.touches[0], e.touches[1]);

          const scaleRatio = newDist / pinchStartDist;

          const prevZoom = zoom;

          const isMobile = window.innerWidth <= 860;

          const minZ = isMobile ? 0.35 : 0.30;

          const maxZ = 1.8;

          zoom = Math.min(maxZ, Math.max(minZ, pinchStartZoom * scaleRatio));

          panX = pinchMidX - ((pinchMidX - panX) * (zoom / prevZoom));

          panY = pinchMidY - ((pinchMidY - panY) * (zoom / prevZoom));

          clampPan();

          applyRoadmapTransform();

        }

      }, { passive: false });



      shell.addEventListener('touchend', (e) => {

        if (hasDragged) {

          suppressCardClickUntil = Date.now() + 250;

        }

        if (e.touches.length === 0) {

          isPointerDown = false;

          hasDragged = false;

          isPinching = false;

        } else if (e.touches.length === 1) {

          isPinching = false;

          isPointerDown = true;

          startX = e.touches[0].clientX;

          startY = e.touches[0].clientY;

          startPanX = panX;

          startPanY = panY;

        }

      });



      // --- WHEEL ZOOM WITH SMOOTH BOUNDS ---

      shell.addEventListener('wheel', (e) => {

        e.preventDefault();

        const rect = shell.getBoundingClientRect();

        const mouseX = e.clientX - rect.left;

        const mouseY = e.clientY - rect.top;



        const prevZoom = zoom;

        const delta = e.deltaY < 0 ? 1.10 : 0.90;

        zoom = Math.min(1.8, Math.max(0.32, zoom * delta));



        panX = mouseX - ((mouseX - panX) * (zoom / prevZoom));

        panY = mouseY - ((mouseY - panY) * (zoom / prevZoom));

        clampPan();

        applyRoadmapTransform();

      }, { passive: false });



      document.getElementById('zoomInBtn').addEventListener('click', () => {

        const prevZoom = zoom;

        zoom = Math.min(1.8, zoom * 1.2);

        const rect = shell.getBoundingClientRect();

        const cx = rect.width / 2;

        const cy = rect.height / 2;

        panX = cx - ((cx - panX) * (zoom / prevZoom));

        panY = cy - ((cy - panY) * (zoom / prevZoom));

        clampPan();

        applyRoadmapTransform();

      });



      document.getElementById('zoomOutBtn').addEventListener('click', () => {

        const prevZoom = zoom;

        zoom = Math.max(0.32, zoom * 0.82);

        const rect = shell.getBoundingClientRect();

        const cx = rect.width / 2;

        const cy = rect.height / 2;

        panX = cx - ((cx - panX) * (zoom / prevZoom));

        panY = cy - ((cy - panY) * (zoom / prevZoom));

        clampPan();

        applyRoadmapTransform();

      });



      document.getElementById('zoomResetBtn').addEventListener('click', () => focusOnProband(true));

      document.getElementById('zoomFitBtn').addEventListener('click', fitEntireRoadmap);

    })();



    // ================= FAN CHART (SUNBURST) =================

    function polarToCartesian(cx, cy, r, angleInDegrees) {

      const rad = (angleInDegrees - 90) * Math.PI / 180.0;

      return { x: cx + (r * Math.cos(rad)), y: cy + (r * Math.sin(rad)) };

    }



    function createAnnularSectorPath(cx, cy, rInner, rOuter, startAngle, endAngle) {

      const startOuter = polarToCartesian(cx, cy, rOuter, endAngle);

      const endOuter = polarToCartesian(cx, cy, rOuter, startAngle);

      const startInner = polarToCartesian(cx, cy, rInner, endAngle);

      const endInner = polarToCartesian(cx, cy, rInner, startAngle);

      const largeArc = (endAngle - startAngle) <= 180 ? '0' : '1';

      return [

        'M', startOuter.x, startOuter.y,

        'A', rOuter, rOuter, 0, largeArc, 0, endOuter.x, endOuter.y,

        'L', endInner.x, endInner.y,

        'A', rInner, rInner, 0, largeArc, 1, startInner.x, startInner.y,

        'Z'

      ].join(' ');

    }



    function renderFanChart(data) {

      const container = document.getElementById('fanChartContainer');

      const size = 680;

      const cx = size / 2;

      const cy = size / 2;

      const nodeMap = {};

      data.nodes.forEach(n => { nodeMap[n.ahnentafel] = n; });



      const statusColors = {

        CONFIRMED_DOC: '#10b981',

        FAMILY_ORAL: '#1D4ED8',

        ARCHIVE_CANDIDATE: '#f59e0b',

        UNKNOWN_SLOT: '#1e293b'

      };



      let pathsHtml = '';

      const probandNode = nodeMap[1];

      pathsHtml += `

        <circle cx="${cx}" cy="${cy}" r="36" fill="#7A1C1C" stroke="#7C5E24" stroke-width="2"

          style="cursor:pointer;" data-ahnentafel="1">

          <title>#1 ${probandNode ? probandNode.full_name : ''} (${probandNode ? probandNode.birth_date : ''})</title>

        </circle>

        <text x="${cx}" y="${cy + 4}" text-anchor="middle" fill="#1A1715" font-size="11" font-weight="800" pointer-events="none">#1 Я</text>

      `;



      const ringThickness = 42;

      for (let gen = 2; gen <= 7; gen++) {

        const count = Math.pow(2, gen - 1);

        const startId = count;

        const rInner = 38 + (gen - 2) * ringThickness;

        const rOuter = rInner + ringThickness - 2;

        const angleStep = 360 / count;



        for (let i = 0; i < count; i++) {

          const ahn = startId + i;

          const node = nodeMap[ahn];

          const a0 = i * angleStep;

          const a1 = (i + 1) * angleStep;

          const d = createAnnularSectorPath(cx, cy, rInner, rOuter, a0, a1 - 0.4);

          const fill = (node && statusColors[node.status]) || '#1e293b';

          const stroke = (node && node.branch === 'paternal') ? 'rgba(224,122,95,0.45)' : 'rgba(42,157,143,0.45)';



          pathsHtml += `

            <path d="${d}" fill="${fill}" stroke="${stroke}" stroke-width="1"

              style="cursor:pointer;" data-ahnentafel="${ahn}">

              <title>#${ahn} (${gen} колено): ${node ? node.full_name : ''} — ${node ? node.birth_place : ''}</title>

            </path>

          `;

        }

      }



      container.innerHTML = `<svg viewBox="0 0 ${size} ${size}" width="100%" height="100%" style="max-width:660px;">${pathsHtml}</svg>`;



