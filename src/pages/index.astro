      // Max generation is always 7 (or 5 for gen5 filter) so the binary tree strictly expands!

      const maxGen = activeFilter === 'gen5' ? 5 : 7;



      function shouldIncludeDirect(n) {

        if (n.generation > maxGen) return false;

        if (activeFilter === 'paternal') {

          return n.branch === 'paternal' || n.branch === 'proband';

        }

        if (activeFilter === 'maternal') {

          return n.branch === 'maternal' || n.branch === 'proband';

        }

        return true;

      }



      const visibleDirect = allDirect.filter(shouldIncludeDirect);

      const visibleCollateral = allCollateral.filter(c => {

        if (c.generation > maxGen) return false;

        if (activeFilter === 'paternal') return c.branch === 'paternal';

        if (activeFilter === 'maternal') return c.branch === 'maternal';

        return true;

      });



      const visibleHypotheses = allHypotheses.filter(h => {

        if (h.generation > maxGen) return false;

        if (activeFilter === 'paternal') return h.branch === 'paternal';

        if (activeFilter === 'maternal') return h.branch === 'maternal';

        return true;

      });



      const hasGen0 = visibleCollateral.some(c => c.generation === 0);
      const startGen = hasGen0 ? 0 : 1;
      const genGroups = {};
      for (let g = startGen; g <= maxGen; g++) genGroups[g] = [];

      visibleDirect.forEach(n => {
        if (genGroups[n.generation]) {
          genGroups[n.generation].push(n);
        }
      });

      // Sort each direct generation by Ahnentafel number
      for (let g = 1; g <= maxGen; g++) {
        if (genGroups[g]) {
          genGroups[g].sort((a, b) => a.ahnentafel - b.ahnentafel);
        }
      }

      const COL_X_STEP = 470;
      const CARD_W = 350;
      const CARD_H = 124;

      // Insert collateral siblings/descendants into their respective generation column
      visibleCollateral.forEach(c => {
        const col = genGroups[c.generation];
        if (!col) return;
        if (c.sibling_of_ahnentafel) {
          const sibIdx = col.findIndex(x => x.ahnentafel === c.sibling_of_ahnentafel);
          if (sibIdx !== -1) {
            col.splice(sibIdx + 1, 0, c);
            return;
          }
        }
        col.push(c);
      });

      const GEN_GAPS = {
        0: 36,
        1: 40,
        2: 50,
        3: 46,
        4: 52,
        5: 42,
        6: 32,
        7: 20
      };

      function getColHeight(g) {
        const count = genGroups[g] ? genGroups[g].length : 0;
        if (count === 0) return 0;
        const gap = GEN_GAPS[g] || 24;
        return count * CARD_H + (count - 1) * gap;
      }

      function getTotalColHeight(g) {
        const baseH = getColHeight(g);
        const hyps = visibleHypotheses.filter(h => h.generation === g);
        const hypH = hyps.length > 0 ? (60 + hyps.length * (CARD_H + 20)) : 0;
        return baseH + hypH;
      }

      const maxColH = Math.max(...Object.keys(genGroups).map(g => getTotalColHeight(Number(g))), 900);
      const TOP_PAD = 110;
      const totalCanvasH = maxColH + TOP_PAD * 2;
      const totalCols = maxGen - startGen + 1;
      const totalCanvasW = totalCols * COL_X_STEP + 360;
      const centerY = totalCanvasH / 2;

      svgEdges.setAttribute('width', String(totalCanvasW));
      svgEdges.setAttribute('height', String(totalCanvasH));

      const coordsByAhn = {};
      const coordsByHyp = {};
      globalCanvasW = totalCanvasW;
      globalCanvasH = totalCanvasH;

      // Calculate coordinates for direct & collateral nodes
      for (let g = startGen; g <= maxGen; g++) {
        const list = genGroups[g] || [];
        const colIndex = g - startGen;
        const colX = 80 + colIndex * COL_X_STEP;
        const gap = GEN_GAPS[g] || 24;
        const colH = getColHeight(g);
        const startY = centerY - colH / 2;

        list.forEach((node, idx) => {
          const y = startY + idx * (CARD_H + gap);
          coordsByAhn[node.ahnentafel] = {
            x: colX,
            y,
            w: node.ahnentafel === 1 ? 370 : CARD_W,
            h: CARD_H,
            node
          };
        });

        // Place floating hypotheses below the column
        const hypsInGen = visibleHypotheses.filter(h => h.generation === g);
        if (hypsInGen.length > 0) {
          const hypStartY = startY + colH + 60;
          hypsInGen.forEach((hyp, hIdx) => {
            const hypY = hypStartY + hIdx * (CARD_H + 22);
            coordsByHyp[hyp.id] = {
              x: colX,
              y: hypY,
              w: CARD_W,
              h: CARD_H,
              hyp
            };
          });
        }
      }

      globalCoordsByAhn = coordsByAhn;
      let htmlParts = [];

      const genTitles = {
        0: ['XXI ВЕК • ПОТОМКИ', 'Дети и племянники рода'],
        1: ['I КОЛЕНО — ПРОБАНД', 'Основатель родового архива (#1)'],
        2: ['II КОЛЕНО — РОДИТЕЛИ', 'Отец, мать, родные дяди и тёти'],
        3: ['III КОЛЕНО — ДЕДУШКИ И БАБУШКИ', 'Оренбургская, Пензенская и Самарская ветви'],
        4: ['IV КОЛЕНО — ПРАДЕДЫ', 'Прадеды и прабабушки • Мост через 1917 год'],
        5: ['V КОЛЕНО — ПРАПРАДЕДЫ', 'Прапрадеды • Перепись 1917 г. (#16–#31)'],
        6: ['VI КОЛЕНО — 32 СЛОТА', 'Прапрапрадеды • Ревизия 1858 г. (#32–#63)'],
        7: ['VII КОЛЕНО — 64 СЛОТА', 'Корни рода • Ревизии 1795–1834 гг. (#64–#127)']
      };

      const romanNumerals = {
        0: 'XXI',
        1: 'I',
        2: 'II',
        3: 'III',
        4: 'IV',
        5: 'V',
        6: 'VI',
        7: 'VII'
      };

      // Generation Banners
      for (let g = startGen; g <= maxGen; g++) {
        if (g === 1) continue; // Proband has royal crown bar
        const colIndex = g - startGen;
        const colX = 80 + colIndex * COL_X_STEP;
        const colH = getColHeight(g);
        const startY = centerY - colH / 2;
        const bannerTop = Math.max(24, startY - 82);
        const [t1, t2] = genTitles[g] || [`${g} КОЛЕНО`, ''];

        htmlParts.push(`
          <div class="canvas-gen-banner" style="left:${colX}px; top:${bannerTop}px; width:${CARD_W}px;">
            <div class="gen-banner-badge">${romanNumerals[g] || g}</div>
            <div class="gen-banner-titles">
              <div class="t1">${t1}</div>
              <div class="t2">${t2}</div>
            </div>
          </div>
        `);

        // Floating hypothesis banner if column has hypotheses
        const hypsInGen = visibleHypotheses.filter(h => h.generation === g);
        if (hypsInGen.length > 0) {
          const hypBannerTop = (centerY - colH / 2) + colH + 24;
          htmlParts.push(`
            <div class="canvas-hyp-banner" style="left:${colX}px; top:${hypBannerTop}px; width:${CARD_W}px;">
              <svg class="svg-icon sm"><use href="#icon-orbit-hypothesis"/></svg> ПАРЯЩИЕ ГИПОТЕЗЫ КОЛЕНА (${hypsInGen.length})
            </div>
          `);
        }
      }

      // Render direct & collateral nodes (Imperial Architectural Standard)
      Object.values(coordsByAhn).forEach(box => {
        const node = box.node;
        const photoSrc = getNodePhoto(node);
        const portraitInner = photoSrc
          ? `<img src="${photoSrc}" alt="${node.full_name}" />`
          : `<div class="rm-portrait-placeholder">${getInitials(node)}</div>`;

        const relBadge = node.relation_label || (
          node.is_collateral
            ? (node.generation === 0
                ? (node.gender === 'F' ? 'Племянница' : 'Племянник')
                : node.generation === 1
                  ? (node.sibling_of_ahnentafel === 1
                      ? (node.gender === 'F' ? 'Родная сестра' : 'Родной брат')
                      : (node.gender === 'F' ? 'Двоюродная сестра' : 'Двоюродный брат'))
                  : node.generation === 2
                    ? (node.gender === 'F' ? 'Тётя' : 'Дядя')
                    : (node.gender === 'F' ? 'Сестра' : 'Брат'))
            : `Слот #${node.ahnentafel}`
        );

        const deathStr = node.death_date ? ` — ${node.death_date}` : '';
        const extraClass = node.ahnentafel === 1 ? 'proband-node' : node.is_collateral ? 'collateral-node' : '';

        let searchHighlightStyle = '';
        if (q) {
          const hay = `${node.full_name || ''} ${node.birth_place || ''} ${node.sub_clan || ''} ${node.notes || ''} #${node.ahnentafel}`.toLowerCase();
          if (hay.includes(q)) {
            searchHighlightStyle = 'outline: 3px solid #7A1C1C; box-shadow: 0 0 24px rgba(122,28,28,0.3); z-index: 15;';
          } else {
            searchHighlightStyle = 'opacity: 0.25;';
          }
        }

        if (activeFilter === 'hypotheses') {
          searchHighlightStyle += ' opacity: 0.35;';
        }

        const isFactConfirmed = node.is_collateral || node.is_relative_proposal || CONFIRMED_FACT_AHNENTAFELS.has(node.ahnentafel) || node.is_fact_confirmed;
        const isPendingSlot = (epistemicMode === 'facts_only' && !isFactConfirmed);

        let cardClasses = `rm-node status-${node.status} branch-${node.branch} ${extraClass}`;
        if (isFactConfirmed) cardClasses += ' is-fact-confirmed';
        if (isPendingSlot) cardClasses += ' is-pending-fact';

        const factBadge = isFactConfirmed ? `<span class="badge-fact-100"><svg class="svg-icon xs"><use href="#icon-seal-confirmed"/></svg> 100% ФАКТ</span>` : '';
        const displayName = isPendingSlot
          ? `Слот #${node.ahnentafel} • Ожидает выписки архива`
          : node.full_name;

        // PROBAND (#1): Founder Card
        if (node.ahnentafel === 1) {
          htmlParts.push(`
            <article
              class="${cardClasses}"
              style="left:${box.x}px; top:${box.y}px; width:${box.w}px; ${searchHighlightStyle}"
              data-ahnentafel="1"
            >
              <div class="rm-proband-crown-bar">
                <div class="rm-proband-crown-title">
                  <svg class="svg-icon xs" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
                  </svg>
                  <span>I КОЛЕНО • ОСНОВАТЕЛЬ РОДОВОГО АРХИВА</span>
                </div>
                ${factBadge}
              </div>
              <div class="rm-card-body">
                <div class="rm-portrait proband-portrait" data-photo-trigger="${node.id}" title="Загрузить фотографию Пробанда">
                  ${portraitInner}
                  <span class="rm-photo-badge"><svg class="svg-icon sm"><use href="#icon-photo"/></svg> Фото</span>
                </div>
                <div class="rm-content">
                  <div class="rm-proband-clan">КАРЕТНИКОВЫ • ЗУБКОВЫ • КУМАНИНЫ • ЮХИНЫ</div>
                  <div class="rm-name proband-name">${displayName}</div>
                  <div class="rm-role-sub">Предприниматель • Основатель Prime Lead • Хранитель архива</div>
                  <div class="rm-meta-row">
                    <span class="rm-dates"><svg class="svg-icon xs"><use href="#icon-calendar"/></svg> 14.09.1994</span>
                    <span class="rm-place"><svg class="svg-icon xs"><use href="#icon-pin"/></svg> г. Самара</span>
                  </div>
                </div>
              </div>
            </article>
          `);
        } else {
          // OTHER GENERATIONS & COLLATERALS
          htmlParts.push(`
            <article
              class="${cardClasses}"
              style="left:${box.x}px; top:${box.y}px; width:${box.w}px; ${searchHighlightStyle}"
              data-ahnentafel="${node.ahnentafel}"
              data-node-clan="${node.sub_clan || node.clan || ''}"
            >
              <div class="rm-card-top-bar">
                <div style="display:flex; align-items:center; gap:5px;">
                  <span class="rm-gen-pill">${romanNumerals[node.generation] || 'I'} КОЛЕНО</span>
                  <span class="ahnentafel-badge">${relBadge}</span>
                </div>
                <div style="display:flex; align-items:center; gap:5px;">
                  ${factBadge}
                  <span class="branch-tag ${node.branch}">${node.sub_clan || (node.branch === 'paternal' ? 'Линия Отца' : 'Линия Матери')}</span>
                </div>
              </div>
              <div class="rm-card-body">
                <div class="rm-portrait" data-photo-trigger="${node.id}" title="Нажмите, чтобы загрузить или обновить фотографию">
                  ${portraitInner}
                  <span class="rm-photo-badge"><svg class="svg-icon sm"><use href="#icon-photo"/></svg> Фото</span>
                </div>
                <div class="rm-content">
                  <div class="rm-name">${displayName}</div>
                  <div class="rm-dates"><svg class="svg-icon xs"><use href="#icon-calendar"/></svg> ${node.birth_date || ''}${deathStr}</div>
                  <div class="rm-place" title="${node.birth_place || ''}"><svg class="svg-icon xs"><use href="#icon-pin"/></svg> ${node.birth_place || 'Село не указано'}</div>
                  ${!isPendingSlot ? getSpecialWaveT1Badges(node) : ''}
                </div>
              </div>
            </article>
          `);
        }
      });

      // Render floating orbital hypotheses
      Object.values(coordsByHyp).forEach(box => {
        const hyp = box.hyp;
        let hypHighlightStyle = '';
        if (q) {
          const hay = `${hyp.full_name} ${hyp.village} ${hyp.role_badge} ${hyp.relationship_hypothesis}`.toLowerCase();
          if (hay.includes(q)) {
            hypHighlightStyle = 'outline: 3px solid #f59e0b; box-shadow: 0 0 32px rgba(245,158,11,0.8); z-index: 15;';
          } else {
            hypHighlightStyle = 'opacity: 0.3;';
          }
        }
        if (activeFilter === 'hypotheses') {
          hypHighlightStyle = 'outline: 3px solid #B45309; box-shadow: 0 0 36px rgba(251,191,36,0.85); z-index: 20;';
        }

        htmlParts.push(`
          <article
            class="rm-node branch-hypothesis is-hypothesis"
            style="left:${box.x}px; top:${box.y}px; width:${box.w}px; ${hypHighlightStyle}"
            data-hyp-id="${hyp.id}"
          >
            <div class="rm-card-top-bar">
              <span class="rm-gen-pill">ГИПОТЕЗА</span>
              <span class="branch-tag branch-hypothesis">${hyp.clan}</span>
            </div>
            <div class="rm-card-body">
              <div class="rm-portrait-placeholder hyp-glyph">
                <svg class="svg-icon sm"><use href="#icon-orbit-hypothesis"/></svg>
              </div>
              <div class="rm-content">
                <div class="rm-name">${hyp.full_name}</div>
                <div class="rm-dates">${hyp.era} • ${hyp.role_badge}</div>
                <div class="rm-place">${hyp.village}</div>
              </div>
            </div>
          </article>
        `);
      });

      nodesLayer.innerHTML = htmlParts.join('');

      // Build SVG connection lines
      let pathsSvg = '';

      Object.values(coordsByAhn).forEach(srcBox => {
        const n = srcBox.node;
        if (!n.is_collateral) {
          const fatherAhn = n.ahnentafel * 2;
          const motherAhn = n.ahnentafel * 2 + 1;
          [fatherAhn, motherAhn].forEach(dstAhn => {
            const dstBox = coordsByAhn[dstAhn];
            if (!dstBox) return;

            const x1 = srcBox.x + srcBox.w;
            const y1 = srcBox.y + srcBox.h / 2;
            const x2 = dstBox.x;
            const y2 = dstBox.y + dstBox.h / 2;
            const cpx1 = x1 + (x2 - x1) * 0.45;
            const cpx2 = x1 + (x2 - x1) * 0.55;

            const strokeColor = dstBox.node.status === 'UNKNOWN_SLOT'
              ? 'rgba(180, 160, 130, 0.4)'
              : dstBox.node.branch === 'paternal'
              ? '#8C6D32'
              : '#146C43';
            const strokeWidth = dstBox.node.status === 'UNKNOWN_SLOT' ? '1.5' : '2.8';
            const dash = dstBox.node.status === 'UNKNOWN_SLOT' ? 'stroke-dasharray="6,5"' : '';

            pathsSvg += `
              <path
                d="M ${x1} ${y1} C ${cpx1} ${y1}, ${cpx2} ${y2}, ${x2} ${y2}"
                fill="none"
                stroke="${strokeColor}"
                stroke-width="${strokeWidth}"
                ${dash}
              />
              <circle cx="${x1}" cy="${y1}" r="3.5" fill="#8C6D32" />
              <circle cx="${x2}" cy="${y2}" r="3.5" fill="${strokeColor}" />
            `;
          });
        } else {
          // Collateral node connectors
          const sibBox = n.sibling_of_ahnentafel ? coordsByAhn[n.sibling_of_ahnentafel] : null;
          if (sibBox) {
            const x1 = sibBox.x + 32;
            const y1 = sibBox.y + sibBox.h;
            const x2 = srcBox.x + 32;
            const y2 = srcBox.y;
            pathsSvg += `
              <line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"
                stroke="#d4af37" stroke-width="2.2" stroke-dasharray="4,4" />
            `;
          }
          const parentAhn = n.parent_ahnentafel || n.father_ahnentafel;
          const parentBox = parentAhn ? coordsByAhn[parentAhn] : null;
          if (parentBox) {
            let x1, y1, x2, y2;
            if (srcBox.x < parentBox.x) {
              // Child on the left (e.g. Gen 0 -> Gen 1)
              x1 = srcBox.x + srcBox.w;
              y1 = srcBox.y + srcBox.h / 2;
              x2 = parentBox.x;
              y2 = parentBox.y + parentBox.h / 2;
            } else {
              // Child on the right
              x1 = srcBox.x;
              y1 = srcBox.y + srcBox.h / 2;
              x2 = parentBox.x + parentBox.w;
              y2 = parentBox.y + parentBox.h / 2;
            }
            const cpx = x1 + (x2 - x1) * 0.5;
            pathsSvg += `
              <path d="M ${x1} ${y1} C ${cpx} ${y1}, ${cpx} ${y2}, ${x2} ${y2}"
                fill="none" stroke="rgba(212, 175, 55, 0.65)" stroke-width="2" stroke-dasharray="6,4" />
              <circle cx="${x1}" cy="${y1}" r="3" fill="#d4af37" />
              <circle cx="${x2}" cy="${y2}" r="3" fill="#d4af37" />
            `;
          }
        }
      });

      // Draw SVG connectors for floating hypotheses

      Object.values(coordsByHyp).forEach(hypBox => {

        const hyp = hypBox.hyp;

        if (hyp.probable_relative_ahnentafel) {

          const relBox = coordsByAhn[hyp.probable_relative_ahnentafel];

          if (relBox) {

            const x1 = relBox.x + relBox.w / 2;

            const y1 = relBox.y + relBox.h;

            const x2 = hypBox.x + hypBox.w / 2;

            const y2 = hypBox.y;

            const cpy1 = y1 + (y2 - y1) * 0.5;

            const cpy2 = y1 + (y2 - y1) * 0.5;



            pathsSvg += `

              <path

                d="M ${x1} ${y1} C ${x1} ${cpy1}, ${x2} ${cpy2}, ${x2} ${y2}"

                fill="none"

                stroke="rgba(245, 158, 11, 0.65)"

                stroke-width="2"

                stroke-dasharray="5,5"

              />

              <circle cx="${x2}" cy="${y2}" r="3.5" fill="#f59e0b" />

            `;

          }

        }

      });



      // Wave T1: Draw Golden Chrono-Link 40-Day SVG Chord between #6 (Vladimir Zubkov) and #27 (Matryona Sabanova, 105 yrs)

      const box6 = coordsByAhn[6];

      const box27 = coordsByAhn[27];

      if (box6 && box27) {

        const x6 = box6.x + box6.w / 2;

        const y6 = box6.y;

        const x27 = box27.x + box27.w / 2;

        const y27 = box27.y;

        const midX = (x6 + x27) / 2;

        const archY = Math.min(y6, y27) - 95;

        pathsSvg += `

          <g class="chrono-link-40-group">

            <path

              d="M ${x6} ${y6} Q ${midX} ${archY}, ${x27} ${y27}"

              fill="none"

              stroke="#B45309"

              stroke-width="2.4"

              stroke-dasharray="7,5"

              opacity="0.88"

            />

            <circle cx="${x6}" cy="${y6}" r="4.5" fill="#B45309" />

            <circle cx="${x27}" cy="${y27}" r="4.5" fill="#B45309" />

            <rect x="${midX - 118}" y="${archY + 18}" width="236" height="24" rx="12" fill="#FEF7ED" stroke="#B45309" stroke-width="1.4" />

            <text x="${midX}" y="${archY + 34}" text-anchor="middle" fill="#7C2D12" font-size="11" font-weight="800">

              Связь 40-го дня (май — 04.07.1981)

            </text>

          </g>

        `;

      }



      svgEdges.innerHTML = pathsSvg;



      // Event listeners for photo upload triggers

      nodesLayer.querySelectorAll('[data-photo-trigger]').forEach(el => {

        el.addEventListener('click', (ev) => {

          triggerPhotoUpload(el.getAttribute('data-photo-trigger'), ev);

        });

      });



      // Event listeners for direct cards

      nodesLayer.querySelectorAll('.rm-node:not(.floating-hypothesis-node)').forEach(card => {

        card.addEventListener('click', (ev) => {

          if (Date.now() < suppressCardClickUntil) return;

          const ahn = parseInt(card.getAttribute('data-ahnentafel'), 10);

          openDossier(ahn);

        });

      });



      // Event listeners for hypothesis cards

      nodesLayer.querySelectorAll('.floating-hypothesis-node').forEach(card => {

        card.addEventListener('click', (ev) => {

          if (Date.now() < suppressCardClickUntil) return;

          const hypId = card.getAttribute('data-hypothesis-id');

          openHypothesisDossier(hypId);

        });

      });

    }



    function focusOnProband(animate = false) {

      const shell = document.getElementById('roadmapShell');

      const world = document.getElementById('roadmapWorld');

      if (!shell) return;

      const viewW = shell.clientWidth || window.innerWidth;

      const viewH = shell.clientHeight || (window.innerHeight - 120);

      if (viewW <= 0 || viewH <= 0) return;



      const isMobile = window.innerWidth <= 860;

      zoom = isMobile ? 0.78 : 0.95;



      const pBox = globalCoordsByAhn[1] || { x: 80, y: (globalCanvasH / 2) - 62, w: 370, h: 124 };

      const cardCenterX = pBox.x + pBox.w / 2;

      const cardCenterY = pBox.y + pBox.h / 2;



      panX = (viewW / 2) - (cardCenterX * zoom);

      panY = (viewH / 2) - (cardCenterY * zoom);

      clampPan();



      if (animate && world) {

        world.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';

        applyRoadmapTransform();

        setTimeout(() => { if (world) world.style.transition = ''; }, 360);

      } else {

        if (world) world.style.transition = '';

        applyRoadmapTransform();

      }

    }



    function fitEntireRoadmap() {

      const shell = document.getElementById('roadmapShell');

      const svgEdges = document.getElementById('roadmapSvgEdges');

      if (!shell || !svgEdges) return;

      const w = parseFloat(svgEdges.getAttribute('width') || '3600');

      const h = parseFloat(svgEdges.getAttribute('height') || '8500');

      const scaleX = (shell.clientWidth - 60) / w;

      const scaleY = (shell.clientHeight - 80) / h;

      zoom = Math.max(0.12, Math.min(scaleX, scaleY, 0.95));

      panX = 30;

      panY = Math.max(20, (shell.clientHeight - h * zoom) / 2);

      applyRoadmapTransform();

    }



    // Focus camera on any specific node on the 2D Roadmap Canvas

    function focusNodeOn2DCanvas(ahnentafelNum) {

      switchView('tree');

      setTimeout(() => {

        const shell = document.getElementById('roadmapShell');

        const targetCard = document.querySelector(`.rm-node[data-ahnentafel="${ahnentafelNum}"]`);

        if (!shell || !targetCard) {

          focusOnProband();

          return;

        }

        const cardX = parseFloat(targetCard.style.left || '80');

        const cardY = parseFloat(targetCard.style.top || '450');

        zoom = window.innerWidth <= 860 ? 0.72 : 0.92;

        panX = (shell.clientWidth / 2) - ((cardX + 155) * zoom);

        panY = (shell.clientHeight / 2) - ((cardY + 54) * zoom);

        applyRoadmapTransform();

        targetCard.style.outline = '3px solid #10b981';

        targetCard.style.boxShadow = '0 0 35px rgba(16, 185, 129, 0.85)';

        setTimeout(() => {

          targetCard.style.outline = '';

          targetCard.style.boxShadow = '';

        }, 2600);

      }, 80);

    }



    // ================= NATIVE MOBILE GENERATION SCROLL ENGINE =================

    function buildKinshipChain(targetAhn, allNodes) {

      const nodeMap = {};

      allNodes.forEach(n => { nodeMap[n.ahnentafel] = n; });

      const target = nodeMap[targetAhn];

      if (!target) return [];



      // If collateral, start from its sibling or parent in direct tree

      const chain = [];

      if (target.is_collateral) {

        chain.unshift(target);

        let currAhn = target.sibling_of_ahnentafel || target.parent_ahnentafel || 1;

        while (currAhn >= 1) {

          const n = nodeMap[currAhn];

          if (n) chain.unshift(n);

          if (currAhn === 1) break;

          currAhn = Math.floor(currAhn / 2);

        }

        return chain;

      }



      let curr = targetAhn;

      while (curr >= 1) {

        const n = nodeMap[curr];

        if (n) chain.unshift(n);

        if (curr === 1) break;

        curr = Math.floor(curr / 2);

      }

      return chain;

    }



    function updateKinshipBreadcrumb(targetAhn) {

      const bar = document.getElementById('kinshipPathBar');

      const stepsEl = document.getElementById('kinshipPathSteps');

      if (!bar || !stepsEl || !lineageData) return;



      if (!targetAhn || targetAhn === 1) {

        selectedKinshipAhn = null;

        bar.classList.remove('visible');

        return;

      }



      selectedKinshipAhn = targetAhn;

      const allNodes = [...(lineageData.nodes || []), ...(lineageData.collateral_nodes || [])];

      const chain = buildKinshipChain(targetAhn, allNodes);

      if (chain.length <= 1) {

        bar.classList.remove('visible');

        return;

      }



      bar.classList.add('visible');

      stepsEl.innerHTML = chain.map((n, idx) => {

        const shortName = `${n.surname || ''} ${n.first_name || ''}`.trim() || `Слот #${n.ahnentafel}`;

        const isLast = idx === chain.length - 1;

        const stepHtml = `

          <span class="kinship-step ${isLast ? 'active-target' : ''}" data-kinship-jump="${n.ahnentafel}" style="cursor:pointer;">

            #${n.ahnentafel} ${shortName}

          </span>

        `;

        return idx < chain.length - 1

          ? `${stepHtml}<span class="kinship-arrow">&rarr;</span>`

          : stepHtml;

      }).join('');



      stepsEl.querySelectorAll('[data-kinship-jump]').forEach(el => {

        el.addEventListener('click', () => {

          const jumpAhn = parseInt(el.getAttribute('data-kinship-jump'), 10);

          scrollToPersonInScroll(jumpAhn);

        });

      });

    }



    function scrollToPersonInScroll(ahnentafelNum) {

      if (!lineageData) return;

      const isFact = CONFIRMED_FACT_AHNENTAFELS.has(ahnentafelNum);

      if (!isFact && scrollEpistemicMode === 'facts_only') {

        scrollEpistemicMode = 'all_levels';

        syncScrollModeButtons();

        renderMobileScroll(lineageData);

      }

      if (scrollClanFilter !== 'all') {

        scrollClanFilter = 'all';

        document.querySelectorAll('#scrollClanPills .scroll-clan-pill').forEach(p => {

          p.classList.toggle('active', p.getAttribute('data-clan') === 'all');

        });

        renderMobileScroll(lineageData);

      }



      updateKinshipBreadcrumb(ahnentafelNum);



      setTimeout(() => {

        const card = document.querySelector(`#scrollGenerationsList .scroll-person-card[data-scroll-ahn="${ahnentafelNum}"]`);

        if (card) {

          card.scrollIntoView({ behavior: 'smooth', block: 'center' });

          card.classList.remove('highlight-target');

          void card.offsetWidth;

          card.classList.add('highlight-target');

        }

      }, 60);

    }



